{
  "name": "@academy/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --packages=external --alias:@academy/shared=../../packages/shared/src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@academy/shared": "*",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
